/* Serial Command Console — Light theme
 * Neutral paper background with a blue accent; the terminal keeps a slightly
 * tinted surface so long log sessions stay comfortable.
 */

QWidget {
    background-color: #eef1f5;
    color: #1c2430;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: #eef1f5;
}

QWidget#TopBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d5dae2;
}

QWidget#Panel {
    background-color: #ffffff;
    border: 1px solid #d5dae2;
    border-radius: 6px;
}

QLabel {
    background: transparent;
    color: #1c2430;
}

QLabel#SectionTitle {
    color: #64707f;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 0;
}

QLabel#FieldLabel {
    color: #64707f;
    font-size: 11px;
}

QLabel#StatusDot {
    font-size: 15px;
    padding-right: 2px;
}

QLabel#HintLabel {
    color: #64707f;
    font-size: 11px;
}

QLabel#SignatureLabel {
    color: #8b95a5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 0 4px;
}

/* ---------------------------------------------------------------- inputs */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QListWidget,
QTreeWidget,
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #cbd2dc;
    border-radius: 5px;
    padding: 4px 7px;
    selection-background-color: #bcd8fb;
    selection-color: #10233b;
    color: #1c2430;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #1f6feb;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background-color: #f1f3f7;
    color: #9aa4b2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: url("@ICONS@/chevron-down-light.png");
    width: 10px;
    height: 6px;
}

QComboBox::down-arrow:disabled {
    opacity: 90;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd2dc;
    selection-background-color: #d8e7fb;
    selection-color: #10233b;
    outline: none;
    padding: 2px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #eef1f5;
    border: none;
    width: 14px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #dfe4ec;
}

/* --------------------------------------------------------------- buttons */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #c6cedb;
    border-radius: 5px;
    padding: 6px 14px;
    color: #24303f;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f4f7fb;
    border-color: #9fb3cd;
}

QPushButton:pressed {
    background-color: #e6ecf4;
    border-color: #1f6feb;
}

QPushButton:disabled {
    background-color: #f2f4f7;
    border-color: #dfe3ea;
    color: #a3acb9;
}

QPushButton:checked {
    background-color: #ddeafd;
    border-color: #1f6feb;
    color: #10396f;
}

QPushButton#PrimaryButton {
    background-color: #1f6feb;
    border-color: #1a5fcc;
    color: #ffffff;
}

QPushButton#PrimaryButton:hover {
    background-color: #2f7ef7;
}

QPushButton#PrimaryButton:pressed {
    background-color: #1957bb;
}

QPushButton#DangerButton {
    background-color: #d64a3a;
    border-color: #bb3b2c;
    color: #ffffff;
}

QPushButton#DangerButton:hover {
    background-color: #e25644;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    color: #3b4757;
}

QToolButton:hover {
    background-color: #e7ecf3;
    border-color: #cbd2dc;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #ddeafd;
    border-color: #1f6feb;
    color: #10396f;
}

/* ------------------------------------------------------- command buttons */
QPushButton#CommandButton {
    background-color: #ffffff;
    border: 1px solid #c9d1de;
    border-radius: 6px;
    padding: 9px 10px;
    text-align: left;
    font-weight: 600;
    color: #1f2a38;
}

QPushButton#CommandButton:hover {
    background-color: #f3f7fd;
    border-color: #1f6feb;
}

QPushButton#CommandButton:pressed {
    background-color: #e3ecf9;
    border-color: #1856bd;
}

QPushButton#CommandButton:disabled {
    background-color: #f2f4f7;
    border-color: #e0e4ea;
    color: #a3acb9;
}

QPushButton#CommandButton[flash="true"] {
    background-color: #cfe3ff;
    border-color: #1f6feb;
    color: #10396f;
}

QPushButton#CommandButton[repeating="true"] {
    border-color: #c88a11;
    background-color: #fdf5e2;
}

QPushButton#CommandButton[blank="true"] {
    color: #8c96a4;
    font-weight: 400;
    border-style: dashed;
}

/* -------------------------------------------------------------- terminal */
QPlainTextEdit#Terminal {
    background-color: #fbfcfe;
    border: 1px solid #d5dae2;
    border-radius: 6px;
    padding: 6px 8px;
    color: #17202c;
    selection-background-color: #bcd8fb;
}

/* ------------------------------------------------------------- scrollbar */
QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #c2cad6;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #a9b3c3;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #c2cad6;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0; width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --------------------------------------------------------------- chrome */
QSplitter::handle {
    background-color: #eef1f5;
}

QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }

QSplitter::handle:hover {
    background-color: #1f6feb;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d5dae2;
    color: #4c5867;
}

QStatusBar::item { border: none; }

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #d5dae2;
}

QMenuBar::item {
    padding: 5px 11px;
    background: transparent;
}

QMenuBar::item:selected {
    background: #e7ecf3;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd2dc;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 26px 6px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #ddeafd;
    color: #10396f;
}

QMenu::separator {
    height: 1px;
    background: #e2e6ec;
    margin: 4px 8px;
}

QGroupBox {
    border: 1px solid #d5dae2;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #64707f;
}

QTabWidget::pane {
    border: 1px solid #d5dae2;
    border-radius: 6px;
    top: -1px;
    background: #ffffff;
}

QTabBar::tab {
    background: transparent;
    color: #64707f;
    padding: 7px 15px;
    border: 1px solid transparent;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1c2430;
    border-color: #d5dae2;
    border-bottom-color: #ffffff;
}

QTabBar::tab:hover:!selected {
    color: #1c2430;
}

QCheckBox, QRadioButton {
    background: transparent;
    spacing: 7px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #b6bfcc;
    border-radius: 3px;
    background: #ffffff;
}

QRadioButton::indicator { border-radius: 8px; }

QCheckBox::indicator:checked {
    image: url("@ICONS@/check.png");
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #1f6feb;
    border-color: #1a5fcc;
}

QCheckBox::indicator:disabled {
    background: #f1f3f7;
    border-color: #dfe3ea;
}

QToolTip {
    background-color: #24303f;
    color: #f2f5f9;
    border: 1px solid #24303f;
    border-radius: 4px;
    padding: 5px 7px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QFrame#Separator {
    background-color: #d5dae2;
    max-width: 1px;
    border: none;
}

QFrame#HSeparator {
    background-color: #d5dae2;
    max-height: 1px;
    border: none;
}

QWidget#DropIndicator {
    background-color: #1f6feb;
    border-radius: 2px;
}

QLabel#BannerInfo {
    background-color: #e4eefc;
    border: 1px solid #9dc2f5;
    border-radius: 5px;
    padding: 7px 10px;
    color: #10396f;
}

QLabel#BannerWarning {
    background-color: #fdf3dd;
    border: 1px solid #e0b34d;
    border-radius: 5px;
    padding: 7px 10px;
    color: #6b4c07;
}

QLabel#BannerError {
    background-color: #fbe4e0;
    border: 1px solid #e19286;
    border-radius: 5px;
    padding: 7px 10px;
    color: #7d2318;
}
